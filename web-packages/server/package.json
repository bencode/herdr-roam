{
  "name": "@herdr-roam/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS=--conditions=development ROAM_PORT=4311 tsx watch src/main.ts",
