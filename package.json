{
  "name": "herdr-roam",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @herdr-roam/server --filter @herdr-roam/web dev",
    "build": "pnpm -r build",
    "start": "pnpm --filter @herdr-roam/server start",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "biome lint ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "esbuild"
    ]
  }
}
